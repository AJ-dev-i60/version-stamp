# --- build version stamp -----------------------------------------------------
# The stamp is handed to the build as APP_VERSION. Nothing here reads git,
# because most build platforms do not expose .git to the build context —
# Coolify, for one, exposes neither .git nor the commit SHA.
#
# Place this as LATE as possible in the runtime stage: the value changes every
# commit, so anything below it rebuilds on every deploy. Last is best.
#
# If the image drops to a non-root user, keep it BEFORE the USER instruction so
# the file lands root-owned and world-readable.
#
# Do NOT put this at the top of the file if the Dockerfile opens with a parser
# directive such as `# syntax=docker/dockerfile:1` — those are only honoured on
# line 1, and Docker silently ignores them anywhere else.

ARG APP_VERSION="dev unknown"
RUN printf '%s\n' "$APP_VERSION" > ./VERSION

# --- if a build stage also needs it (e.g. Nuxt reads it in nuxt.config) ------
# ARG APP_VERSION="dev unknown"
# ENV APP_VERSION=$APP_VERSION
